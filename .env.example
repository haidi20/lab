# Copy file ini menjadi .env, lalu isi nilai aslinya.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_HOTSPOT_PROFILE=default
MIKROTIK_VERIFY_TLS=true
MIKROTIK_AUTO_EXPIRE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@hn_assistent_bot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=telegram_group_reader
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=telegram_data
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_OWNER_NAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_DEVELOPMENT_KEY=
DIGIFLAZZ_TESTING=false
PRODUCT_CATALOG_PATH=modules/telegram_store/data/products.sqlite3
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_WEBHOOK_SECRET=
STORE_MARKUP_PERCENT=0
ACCURATE_EMAIL=
