# Copy file ini menjadi .env, lalu isi nilai aslinya.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_HOTSPOT_PROFILE=default
MIKROTIK_VERIFY_TLS=true
MIKROTIK_AUTO_EXPIRE=true

TELEGRAM_BOT_TOKEN=
